# Copia este fichero a server/local.env en cada máquina y ajústalo. local.env no se versiona.

# --- Servidor ---
RESULTS_ROOT="$HOME/psge-results"   # dónde se escriben los resultados (fuera del repo)
CONDA_ENV="psge-original"
# N_JOBS=16                          # procesos por problema; por defecto, la mitad de los núcleos
# PYTHON=/ruta/a/python              # solo si no usas conda

# --- Portátil (para server/fetch_results.sh) ---
SERVER="usuario@servidor"            # host de ssh (o un alias de ~/.ssh/config)
SERVER_RESULTS="psge-results"        # RESULTS_ROOT en el servidor (relativo a su $HOME)
LOCAL_RESULTS="$HOME/psge-results"   # en el portátil, FUERA de OneDrive
